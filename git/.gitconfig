[core]
	# Globalny .gitignore (XDG) — symlink do git/ignore z tego repo
	excludesfile = ~/.config/git/ignore

[user]
	# Nie zgaduj tożsamości z loginu i hostname. Bez tego git przy braku
	# ~/.gitconfig.local commituje jako "user@hostname.local" i nic nie mówi.
	useConfigOnly = true

# Tożsamość (name, email) NIE jest wersjonowana — siedzi w pliku lokalnym.
# Szablon: git/.gitconfig.local.example. Brak pliku = git po cichu pomija include.
[include]
	path = ~/.gitconfig.local
