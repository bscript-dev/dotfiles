# ~/.gitconfig.local — tożsamość gita. NIE trafia do repo.
# Skopiuj do ~/.gitconfig.local i wpisz swoje dane:
#   cp git/.gitconfig.local.example ~/.gitconfig.local
#
# Bez tego pliku `git commit` odmówi: "Please tell me who you are".

[user]
	name = Imię Nazwisko
	email = ty@example.com

# Osobna tożsamość dla wybranego katalogu z repo (np. praca vs prywatne):
# [includeIf "gitdir:~/work/"]
# 	path = ~/.gitconfig.work